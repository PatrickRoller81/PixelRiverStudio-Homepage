<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Pixel River Studio</title>
  <meta name="description" content="{{ description or 'KI-gestützte Web-Apps, Mobile Apps und Automatisierungen für Ihr Business. Patrick Roller — Pixel River Studio, Nagold-Hochdorf.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>document.documentElement.classList.add('js');</script>
</head>
<body>

  <div class="scroll-progress" aria-hidden="true"></div>

  <header>
    <nav>
      <a href="/" class="logo-wrap">
        <img src="/assets/img/logo.svg" alt="Pixel River Studio Logo" class="logo-img">
        <span class="logo-text">Pixel River <em>Studio</em></span>
      </a>
      <ul class="nav-links">
        <li><a href="/#leistungen">Leistungen</a></li>

        <li><a href="/gaming/">Gaming</a></li>
        <li><a href="mailto:info@pixelriverstudio.de" class="btn-cta">Kontakt</a></li>
      </ul>
    </nav>
  </header>

  <main>{{ content | safe }}</main>

  {% if comments == true %}
  <section class="comments-wrap">
    <h2 class="comments-title">Kommentare</h2>
    <script src="https://giscus.app/client.js"
      data-repo="PatrickRoller81/PixelRiverStudio-Homepage"
      data-repo-id="R_kgDOR4XlDQ"
      data-category="DevLog Comments"
      data-category-id="DIC_kwDOR4XlDc4C6hfr"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="dark"
      data-lang="de"
      crossorigin="anonymous"
      async>
    </script>
  </section>
  {% endif %}

  <footer>
    <span class="foot-copy">© 2026 Pixel River Studio · Patrick Roller · Im Reesengarten 29 · 72202 Nagold-Hochdorf</span>
    <ul class="foot-links">
      <li><a href="https://github.com/PatrickRoller81" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="/impressum/">Impressum</a></li>
      <li><a href="/datenschutz/">Datenschutz</a></li>
    </ul>
  </footer>

  <script>
    (function () {
      var items = document.querySelectorAll('[data-reveal]');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach(function (el) { el.classList.add('is-visible'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();

    // Scroll-Progress: haarduenne Verlaufslinie oben, scroll-synchron
    (function () {
      var bar = document.querySelector('.scroll-progress');
      if (!bar) return;
      var ticking = false;
      var update = function () {
        var d = document.documentElement;
        var max = d.scrollHeight - d.clientHeight;
        bar.style.transform = 'scaleX(' + (max > 0 ? d.scrollTop / max : 0) + ')';
        ticking = false;
      };
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    })();
  </script>
</body>
</html>
