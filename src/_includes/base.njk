<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://giscus.app; style-src 'self' 'unsafe-inline' https://giscus.app; font-src 'self'; img-src 'self' data:; media-src 'self'; frame-src https://giscus.app; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Pixel River Studio</title>
  <meta name="description" content="{{ description or 'KI-gestützte Web-Apps, Mobile Apps und Automatisierungen für Ihr Business. Patrick Roller — Pixel River Studio, Nagold-Hochdorf.' }}">
  <link rel="preload" href="/assets/fonts/syne-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/syne-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v={{ buildTime }}">
  <script src="/assets/js/js-flag.js?v={{ buildTime }}"></script>
</head>
<body>

  <div class="scroll-progress" aria-hidden="true"></div>

  <header>
    <nav>
      <a href="/" class="logo-wrap">
        <img src="/assets/img/logo.svg" alt="Pixel River Studio Logo" class="logo-img">
        <span class="logo-text">Pixel River <em>Studio</em></span>
      </a>
      <ul class="nav-links">
        <li><a href="/#leistungen">Leistungen</a></li>
        <li><a href="/#werbevideo">Werbevideo</a></li>

        <li><a href="/gaming/">Gaming</a></li>
        <li><a href="mailto:info@pixelriverstudio.de" class="btn-cta">Kontakt</a></li>
      </ul>
    </nav>
  </header>

  <main>{{ content | safe }}</main>

  {% if comments == true %}
  <section class="comments-wrap">
    <h2 class="comments-title">Kommentare</h2>
    <script src="https://giscus.app/client.js"
      data-repo="PatrickRoller81/PixelRiverStudio-Homepage"
      data-repo-id="R_kgDOR4XlDQ"
      data-category="DevLog Comments"
      data-category-id="DIC_kwDOR4XlDc4C6hfr"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="dark"
      data-lang="de"
      crossorigin="anonymous"
      async>
    </script>
  </section>
  {% endif %}

  <footer>
    <span class="foot-copy">© 2026 Pixel River Studio · Patrick Roller · Im Reesengarten 29 · 72202 Nagold-Hochdorf</span>
    <ul class="foot-links">
      <li><a href="https://github.com/PatrickRoller81" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="/impressum/">Impressum</a></li>
      <li><a href="/datenschutz/">Datenschutz</a></li>
    </ul>
  </footer>

  <script src="/assets/js/site.js?v={{ buildTime }}"></script>
</body>
</html>
